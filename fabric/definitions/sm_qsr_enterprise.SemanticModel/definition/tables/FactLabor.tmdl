table FactLabor
	lineageTag: 88eefe49-9a97-4d8a-8285-905f2886ec92
	sourceLineageTag: [fact].[FactLabor]

	/// Sum of LaborCost from labor shift records.
	measure 'Total Labor Cost' = SUM ( FactLabor[LaborCost] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Labor
		lineageTag: 8d9e2267-aaf9-4978-89d6-76fee92426bc

	/// Sum of RegularHours from labor shift records.
	measure 'Regular Labor Hours' = SUM ( FactLabor[RegularHours] )
		formatString: #,0.00
		displayFolder: Labor
		lineageTag: 7aa7ab66-6b16-4fbd-b67d-c1d35582a4b9

	/// Sum of OvertimeHours from labor shift records.
	measure 'Overtime Labor Hours' = SUM ( FactLabor[OvertimeHours] )
		formatString: #,0.00
		displayFolder: Labor
		lineageTag: f5f238bc-59fa-459d-ad19-0acfb147edfc

	/// Regular plus overtime hours.
	measure 'Total Labor Hours' = [Regular Labor Hours] + [Overtime Labor Hours]
		formatString: #,0.00
		displayFolder: Labor
		lineageTag: f9c2e17e-bd8c-46ca-b528-0244812ecb14

	/// Overtime hours divided by total labor hours.
	measure 'Overtime %' = DIVIDE ( [Overtime Labor Hours], [Total Labor Hours] )
		formatString: 0.00%
		displayFolder: Labor
		lineageTag: 16669f5d-787c-4912-8c4d-250cc78e774e

