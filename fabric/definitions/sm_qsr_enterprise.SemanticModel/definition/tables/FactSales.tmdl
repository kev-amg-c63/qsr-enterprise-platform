table FactSales
	lineageTag: 639ab83a-b125-49e5-80a8-d23e0e61b14c
	sourceLineageTag: [fact].[FactSales]

	/// Net sales from transaction headers; excludes tax. Product filtering applies to Line Sales instead.
	measure 'Total Sales' = SUM ( FactSales[NetSales] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Sales
		lineageTag: 192df5a1-3f59-4c0e-9265-9206a3789e98

	/// Gross sales before discounts from transaction headers.
	measure 'Gross Sales' = SUM ( FactSales[GrossSales] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Sales
		lineageTag: 0ace531b-8790-469c-a4f3-9e2691cc51b1

	/// Discount amounts from transaction headers.
	measure 'Sales Discounts' = SUM ( FactSales[DiscountAmount] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Sales
		lineageTag: deb952c0-dfcb-4efe-9069-3e70b5bf3ccd

	/// Sum of transaction-header item counts.
	measure 'Units Sold' = SUM ( FactSales[ItemCount] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 9b06efef-075a-474a-94ba-2266c19d5518

	/// Distinct transaction surrogate keys; avoids assuming TransactionID is globally unique.
	measure 'Transaction Count' = DISTINCTCOUNTNOBLANK ( FactSales[SalesKey] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: d7ec90e8-1ecd-41f9-b26c-51bc2af74a0a

	/// Net transaction sales divided by distinct transactions.
	measure 'Average Ticket' = DIVIDE ( [Total Sales], [Transaction Count] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Sales
		lineageTag: 39b03eec-a149-4128-a38b-9870cb0d09a9

	/// Calendar year-to-date net sales using the active sales date relationship.
	measure 'Sales YTD' = CALCULATE ( [Total Sales], REMOVEFILTERS ( DimDate ), DATESYTD ( DimDate[FullDate] ) )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Time Intelligence
		lineageTag: 8120f7b7-917f-433c-a430-e51d32658446

	/// Net sales for the prior-year corresponding date period; blank if no corresponding data.
	measure 'Sales LY' = CALCULATE ( [Total Sales], REMOVEFILTERS ( DimDate ), SAMEPERIODLASTYEAR ( DimDate[FullDate] ) )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Time Intelligence
		lineageTag: 2d766a92-a754-431a-9f77-5051bcf8de04

	/// Change versus the same period last year; blank when prior sales are absent or zero.
	measure 'YoY Sales Growth %' = VAR PriorSales = [Sales LY] RETURN IF ( NOT ISBLANK ( [Total Sales] ) && NOT ISBLANK ( PriorSales ), DIVIDE ( [Total Sales] - PriorSales, PriorSales ) )
		formatString: 0.00%
		displayFolder: Time Intelligence
		lineageTag: ac51bb26-b2ce-484a-8807-12ebb2e0ca92

	/// Calendar month-to-date net sales using the active sales date relationship.
	measure 'Sales MTD' = CALCULATE ( [Total Sales], REMOVEFILTERS ( DimDate ), DATESMTD ( DimDate[FullDate] ) )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Time Intelligence
		lineageTag: 600b9944-b9ba-4547-b906-ae2a774d925e

