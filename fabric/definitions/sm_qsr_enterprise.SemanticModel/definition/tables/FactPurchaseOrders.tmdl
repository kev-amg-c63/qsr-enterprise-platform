table FactPurchaseOrders
	lineageTag: e98de27a-2028-4614-a881-30b6079ec4f8
	sourceLineageTag: [fact].[FactPurchaseOrders]

	/// Distinct nonblank purchase order identifiers.
	measure 'Purchase Order Count' = DISTINCTCOUNTNOBLANK ( FactPurchaseOrders[PurchaseOrderID] )
		formatString: #,0
		displayFolder: Purchasing
		lineageTag: 15a62ed7-687f-4722-8835-6760416c250e

	/// Sum of ExtendedCost at purchase order line grain, filtered by active order date.
	measure 'Purchase Order Value' = SUM ( FactPurchaseOrders[ExtendedCost] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Purchasing
		lineageTag: 54b15811-849b-4ef3-bc75-f74d8a7f2666

	/// Sum of OrderedQuantity at purchase order line grain, filtered by active order date.
	measure 'Ordered Quantity' = SUM ( FactPurchaseOrders[OrderedQuantity] )
		formatString: #,0.00
		displayFolder: Purchasing
		lineageTag: 6318c858-187f-4729-94a5-d0484eee2589

	/// Sum of ReceivedQuantity at purchase order line grain, filtered by active order date.
	measure 'Received Quantity' = SUM ( FactPurchaseOrders[ReceivedQuantity] )
		formatString: #,0.00
		displayFolder: Purchasing
		lineageTag: 5d5f0548-1a6c-4661-93e4-84b04f501117

	/// Received quantity divided by ordered quantity; not an on-time delivery metric.
	measure 'Receipt Fulfillment %' = DIVIDE ( [Received Quantity], [Ordered Quantity] )
		formatString: 0.00%
		displayFolder: Purchasing
		lineageTag: 6f7b869c-f68a-4b67-b1ad-725663e62eab

