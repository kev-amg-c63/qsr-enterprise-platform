table FactMarketing
	lineageTag: 50726ed8-d1e3-4a54-8c48-80bbc68cbde0
	sourceLineageTag: [fact].[FactMarketing]

	/// Sum of reported marketing SpendAmount.
	measure 'Marketing Spend' = SUM ( FactMarketing[SpendAmount] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Marketing
		lineageTag: 857ccbdd-67c9-490c-90b9-f207b187abde

	/// Sum of reported marketing AttributedRevenue.
	measure 'Attributed Revenue' = SUM ( FactMarketing[AttributedRevenue] )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Marketing
		lineageTag: 6496549c-4a36-420d-b9e7-a41607ee8498

	/// Sum of reported marketing Impressions.
	measure 'Total Impressions' = SUM ( FactMarketing[Impressions] )
		formatString: #,0
		displayFolder: Marketing
		lineageTag: bcd07c2d-a7bc-4cdb-89db-7883e4645bbc

	/// Sum of reported marketing Clicks.
	measure 'Total Clicks' = SUM ( FactMarketing[Clicks] )
		formatString: #,0
		displayFolder: Marketing
		lineageTag: e3a5295c-c681-4a28-b26d-1774dd6b5806

	/// Sum of reported marketing Conversions.
	measure 'Total Conversions' = SUM ( FactMarketing[Conversions] )
		formatString: #,0
		displayFolder: Marketing
		lineageTag: f7ab7ca2-8d0e-4805-bee3-b8e4e12a382b

	/// Clicks divided by impressions.
	measure 'Click-Through Rate %' = DIVIDE ( [Total Clicks], [Total Impressions] )
		formatString: 0.00%
		displayFolder: Marketing
		lineageTag: 4bfbcbf0-31c9-4998-aa13-d343fe3b6f1b

	/// Reported conversions divided by clicks.
	measure 'Conversion Rate %' = DIVIDE ( [Total Conversions], [Total Clicks] )
		formatString: 0.00%
		displayFolder: Marketing
		lineageTag: bd369b76-f090-4742-aa56-c11e7755f602

	/// Attributed revenue divided by marketing spend; revenue multiple, not profit ROI.
	measure 'Return on Ad Spend' = DIVIDE ( [Attributed Revenue], [Marketing Spend] )
		formatString: 0.00"x"
		displayFolder: Marketing
		lineageTag: aae4c60c-0b59-437e-a582-6c837a7b6fd9

