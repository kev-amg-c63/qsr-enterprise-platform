table FactInventory
	lineageTag: ba8c4e1b-16f4-4cac-8577-33a4b3faa686
	sourceLineageTag: [fact].[FactInventory]

	/// Latest available snapshot per store and product within the selected filter period; does not sum balances across snapshots or carry balances from before the selected period.
	measure 'Inventory Value (Latest Snapshot)' = SUMX ( SUMMARIZE ( FactInventory, FactInventory[StoreKey], FactInventory[ProductKey] ), VAR LastSnapshot = CALCULATE ( MAX ( FactInventory[SnapshotTimestamp] ) ) RETURN CALCULATE ( SUM ( FactInventory[InventoryValue] ), KEEPFILTERS ( FactInventory[SnapshotTimestamp] = LastSnapshot ) ) )
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: Inventory
		lineageTag: fc5fcfbd-bc0c-49d2-8821-264931ee9de0

	/// Latest available snapshot per store and product within the selected filter period; does not sum balances across snapshots or carry balances from before the selected period.
	measure 'Quantity On Hand (Latest Snapshot)' = SUMX ( SUMMARIZE ( FactInventory, FactInventory[StoreKey], FactInventory[ProductKey] ), VAR LastSnapshot = CALCULATE ( MAX ( FactInventory[SnapshotTimestamp] ) ) RETURN CALCULATE ( SUM ( FactInventory[QuantityOnHand] ), KEEPFILTERS ( FactInventory[SnapshotTimestamp] = LastSnapshot ) ) )
		formatString: #,0.00
		displayFolder: Inventory
		lineageTag: c6d3625b-bf03-4409-9933-3b08215329af

	/// Latest available snapshot per store and product within the selected filter period; does not sum balances across snapshots or carry balances from before the selected period.
	measure 'Quantity Reserved (Latest Snapshot)' = SUMX ( SUMMARIZE ( FactInventory, FactInventory[StoreKey], FactInventory[ProductKey] ), VAR LastSnapshot = CALCULATE ( MAX ( FactInventory[SnapshotTimestamp] ) ) RETURN CALCULATE ( SUM ( FactInventory[QuantityReserved] ), KEEPFILTERS ( FactInventory[SnapshotTimestamp] = LastSnapshot ) ) )
		formatString: #,0.00
		displayFolder: Inventory
		lineageTag: a52f3b79-b639-42fe-baae-7f8a2f297405

